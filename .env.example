# Copy to .env (local/Docker) or add these in Netlify → Site configuration → Environment variables.
# Generate random values with:  openssl rand -hex 32
# Moving from the old version? Use the SAME TEMPLATE_KEY as before, or enrolled faces stop working.
JWT_SECRET=
TEMPLATE_KEY=

# School time zone for "today" (default Africa/Lusaka)
# SCHOOL_TZ=Africa/Lusaka

# Optional: use your own Postgres (Neon, Supabase, a server) instead of the built-in one
# DATABASE_URL=postgres://user:pass@host/db

# Optional tuning (SFace cosine similarity)
# REVIEW_THRESHOLD=0.363
# MATCH_THRESHOLD=0.45
