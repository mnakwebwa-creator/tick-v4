{
  "name": "tick-attendance",
  "private": true,
  "type": "module",
  "description": "Tick — school attendance by photo",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env server/node.js",
    "dev:web": "vite",
    "build": "node scripts/fetch-models.mjs && tsc -p web && vite build",
    "start": "node --env-file-if-exists=.env server/node.js",
